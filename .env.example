# Supabase PostgreSQL Connection String (Transaction pooler for App Engine / Serverless)
DATABASE_URL="postgresql://postgres.[PROJECT_ID]:[YOUR_PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase Direct Connection (Session mode for migrations)
DIRECT_URL="postgresql://postgres.[PROJECT_ID]:[YOUR_PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# JWT Secret for Session Authentication
JWT_SECRET="civictrack-super-secret-jwt-key-2026-production"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
